{
  "id": "me.rerere.fawntavern.frontend",
  "name": "FawnTavern 酒馆助手",
  "version": "0.2.1",
  "author": "FawnTavern",
  "description": "HTML 前端卡、本地库环境及 MVU 变量面板兼容",
  "entry": "index.js",
  "capabilities": [
    "message-renderer",
    "session-frontend",
    "generation-lifecycle"
  ],
  "permissions": [
    "character.read",
    "variables.read",
    "variables.write"
  ],
  "configSchema": {
    "type": "object",
    "properties": {
      "runCharacterScripts": {
        "type": "boolean",
        "title": "运行角色脚本 / Run character scripts",
        "default": false
      }
    }
  },
  "autoUpdate": true,
  "update": {
    "repo": "weiruchenai1/fawntavern-frontend-renderer"
  },
  "homePage": "https://github.com/weiruchenai1/fawntavern-frontend-renderer"
}
